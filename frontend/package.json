{
  "name": "starter",
  "description": "Include Bootstrap CSS and JS via the jsDelivr CDN.",
  "version": "0.0.0",
  "private": true,
  "repository": "twbs/examples",
  "license": "MIT",
  "stackblitz": {
    "startCommand": "npm start"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "cross-env NODE_ENV=development nodemon node app.js",
    "pro": "cross-env NODE_ENV=production nodemon node app.js",
    "build:static": "bash scripts/build-static-site.sh",
    "start:pm2": "pm2 start ecosystem-dev.config.json --no-daemon",
    "start:pm2-production": "pm2 start ecosystem.config.json --no-daemon"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.1",
    "ethers": "^5.6.8",
    "express": "^4.18.1",
    "express-group-routes": "^1.1.0",
    "nodemon": "^2.0.16"
  },
  "devDependencies": {
    "sirv-cli": "^2.0.2"
  },
  "nodemonConfig": {
    "ignore": [
      "assets/*"
    ]
  }
}