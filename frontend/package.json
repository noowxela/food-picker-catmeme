{
  "name": "starter",
  "description": "Include Bootstrap CSS and JS via the jsDelivr CDN.",
  "version": "0.0.0",
  "private": true,
  "repository": "twbs/examples",
  "license": "MIT",
  "stackblitz": {
    "startCommand": "npm start"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "cross-env NODE_ENV=development node --watch app.js",
    "pro": "cross-env NODE_ENV=production node --watch app.js",
    "build:static": "bash scripts/build-static-site.sh",
    "start:pm2": "pm2 start ecosystem-dev.config.json --no-daemon",
    "start:pm2-production": "pm2 start ecosystem.config.json --no-daemon"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.3",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "express-group-routes": "^1.1.0"
  },
  "devDependencies": {
    "sirv-cli": "^3.0.1"
  }
}